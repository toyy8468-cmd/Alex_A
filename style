*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --red-dark:#7a0000;--red-main:#b01010;--red-bright:#e02020;--red-accent:#ff4444;
  --gold:#f5a623;--gold-light:#ffd700;
  --dark-bg:#1a0000;--dark-card:#260a0a;--dark-card2:#1f0808;
  --text-light:#f5e6e6;--text-dim:#c8a0a0;
  --green-ok:#22c55e;--border:rgba(200,60,60,0.25);
}
html{scroll-behavior:smooth}
body{font-family:'Sarabun',sans-serif;background:var(--dark-bg);color:var(--text-light);min-height:100vh;overflow-x:hidden;background-image:radial-gradient(ellipse at 20% 20%,rgba(180,20,20,.12) 0%,transparent 60%),radial-gradient(ellipse at 80% 80%,rgba(100,0,0,.15) 0%,transparent 60%)}
a{text-decoration:none;color:inherit}
img{max-width:100%}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--dark-bg)}
::-webkit-scrollbar-thumb{background:var(--red-main);border-radius:3px}

/* NAVBAR */
.navbar{position:sticky;top:0;z-index:1000;display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;background:linear-gradient(135deg,#1a0000,#2d0808);border-bottom:1px solid var(--border);box-shadow:0 2px 20px rgba(180,0,0,.3)}
.nav-left,.nav-right{display:flex;align-items:center;gap:.75rem}
.logo{font-family:'Kanit',sans-serif;font-weight:900;font-size:1.4rem;background:linear-gradient(135deg,#ff6b6b,var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hamburger,.search-btn{background:none;border:none;color:var(--text-light);font-size:1.3rem;cursor:pointer;padding:.3rem;transition:color .2s}
.hamburger:hover,.search-btn:hover{color:var(--gold)}
.balance-chip{display:flex;align-items:center;gap:.4rem;background:linear-gradient(135deg,var(--red-dark),#3d0000);border:1px solid var(--red-accent);border-radius:999px;padding:.4rem 1rem;font-weight:700;color:var(--gold);font-size:.9rem;cursor:pointer;transition:all .2s;white-space:nowrap}
.balance-chip:hover{background:linear-gradient(135deg,var(--red-main),var(--red-dark))}

/* SEARCH */
.search-bar-container{display:none;position:relative;padding:.75rem 1rem;background:var(--dark-card);border-bottom:1px solid var(--border)}
.search-bar-container.visible{display:block}
.search-bar-container input{width:100%;padding:.75rem 1rem;background:var(--dark-bg);border:1px solid var(--border);border-radius:8px;color:var(--text-light);font-family:'Sarabun',sans-serif;font-size:1rem;outline:none}
.search-bar-container input:focus{border-color:var(--red-bright)}
.search-results{position:absolute;top:calc(100% - .75rem);left:1rem;right:1rem;background:var(--dark-card2);border:1px solid var(--border);border-radius:0 0 8px 8px;z-index:200;max-height:300px;overflow-y:auto}
.search-result-item{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;cursor:pointer;transition:background .15s}
.search-result-item:hover{background:rgba(180,0,0,.2)}

/* SIDEBAR */
.sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1001;backdrop-filter:blur(2px)}
.sidebar-overlay.active{display:block}
.sidebar{position:fixed;left:-300px;top:0;bottom:0;width:280px;z-index:1002;background:linear-gradient(180deg,#1a0000,#120000);border-right:1px solid var(--border);transition:left .3s cubic-bezier(.4,0,.2,1);overflow-y:auto;box-shadow:4px 0 30px rgba(0,0,0,.5)}
.sidebar.open{left:0}
.sidebar-header{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1rem;border-bottom:1px solid var(--border)}
.sidebar-logo{font-family:'Kanit',sans-serif;font-weight:900;font-size:1.3rem;background:linear-gradient(135deg,#ff6b6b,var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.close-sidebar{background:none;border:none;color:var(--text-dim);font-size:1.2rem;cursor:pointer}
.close-sidebar:hover{color:var(--red-accent)}
.sidebar-nav{padding:1rem 0}
.sidebar-nav a{display:block;padding:.85rem 1.25rem;color:var(--text-light);font-size:1rem;font-weight:500;transition:all .2s}
.sidebar-nav a:hover{background:rgba(180,20,20,.2);color:var(--gold);padding-left:1.75rem}
.sidebar-divider{text-align:center;padding:.5rem 1rem;color:var(--text-dim);font-size:.8rem;border-top:1px solid var(--border);margin-top:.5rem;letter-spacing:1px;text-transform:uppercase}
.sidebar-user-card{margin:.75rem;background:var(--dark-card);border:1px solid var(--border);border-radius:12px;padding:1rem}
.sidebar-user-name{font-weight:700;font-size:1rem;color:var(--text-light);margin-bottom:.25rem}
.sidebar-user-balance{color:var(--gold);font-size:.9rem}
.sidebar-user-links{padding:0 0 1rem}
.sidebar-user-links a{display:block;padding:.75rem 1.25rem;color:var(--text-dim);font-size:.95rem;transition:all .2s}
.sidebar-user-links a:hover{color:var(--gold);background:rgba(180,20,20,.15)}

/* MAIN */
.main-content{padding-bottom:3rem}
.page{display:none;animation:fadeIn .3s ease}
.page.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* HERO */
.hero-banner{position:relative;overflow:hidden;min-height:300px;background:linear-gradient(135deg,#3d0000,#800000,#1a0000);display:flex;align-items:center;justify-content:center;padding:2rem 1.5rem}
.hero-particles{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,100,100,.15) 1px,transparent 1px);background-size:30px 30px;animation:particleMove 20s linear infinite}
@keyframes particleMove{from{transform:translateY(0)}to{transform:translateY(-30px)}}
.hero-content{position:relative;text-align:center;max-width:600px}
.hero-title{font-family:'Kanit',sans-serif;font-weight:900;font-size:clamp(2rem,8vw,3.5rem);background:linear-gradient(135deg,#fff,var(--gold),#ff6b6b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1.1;margin-bottom:.5rem;filter:drop-shadow(0 0 20px rgba(255,100,100,.4))}
.hero-subtitle{font-size:1.1rem;color:var(--gold);font-weight:700;margin-bottom:.5rem}
.hero-desc{color:var(--text-dim);font-size:.95rem;margin-bottom:1.5rem}
.hero-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}

/* BUTTONS */
.btn-primary{background:linear-gradient(135deg,var(--red-bright),var(--red-dark));color:#fff;border:none;border-radius:999px;padding:.75rem 1.75rem;font-size:1rem;font-weight:700;cursor:pointer;transition:all .2s;font-family:'Sarabun',sans-serif;box-shadow:0 4px 15px rgba(180,0,0,.4)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(180,0,0,.6)}
.btn-secondary{background:transparent;color:var(--text-light);border:2px solid rgba(255,255,255,.4);border-radius:999px;padding:.75rem 1.75rem;font-size:1rem;font-weight:700;cursor:pointer;transition:all .2s;font-family:'Sarabun',sans-serif}
.btn-secondary:hover{border-color:var(--gold);color:var(--gold)}
.btn-gold{background:linear-gradient(135deg,var(--gold),#c8820a);color:#1a0000;border:none;border-radius:999px;padding:.6rem 1.5rem;font-size:.95rem;font-weight:700;cursor:pointer;transition:all .2s;font-family:'Sarabun',sans-serif}
.btn-gold:hover{transform:translateY(-1px);box-shadow:0 4px 15px rgba(245,166,35,.4)}
.full-width{width:100%;margin-top:.5rem}

/* ANNOUNCEMENT */
.announcement-banner{margin:1rem;background:linear-gradient(135deg,#1a0a00,#2d1500);border:2px solid var(--gold);border-radius:16px;padding:1.25rem;box-shadow:0 0 20px rgba(245,166,35,.2)}
.announce-inner{text-align:center}
.announce-icon{font-size:1.5rem}
.announce-inner strong{display:block;color:var(--gold);font-size:1.1rem;margin:.5rem 0}
.announce-inner p{color:var(--text-dim);font-size:.9rem;margin-bottom:1rem}
.announce-btn{background:linear-gradient(135deg,var(--gold),#c8820a);color:#1a0000;border:none;border-radius:999px;padding:.6rem 1.5rem;font-weight:700;cursor:pointer;font-family:'Sarabun',sans-serif;font-size:.95rem}

/* READ BEFORE BUY */
.read-before-buy{margin:1rem;background:var(--dark-card);border-radius:12px;padding:1.25rem;border:1px solid var(--border);text-align:center}
.read-before-buy h2{color:var(--gold);margin-bottom:.75rem;font-size:1.3rem}
.read-before-buy p{color:var(--text-dim);margin-bottom:.5rem;font-size:.95rem}

/* STATS */
.stats-section{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.75rem;margin:1rem}
.stat-card{background:var(--dark-card);border:1px solid var(--border);border-radius:12px;padding:1rem;display:flex;align-items:center;gap:.75rem}
.stat-icon{font-size:2rem}
.stat-label{font-size:.8rem;color:var(--text-dim)}
.stat-value{font-family:'Kanit',sans-serif;font-size:1.5rem;font-weight:800;color:var(--red-accent)}
.stat-sub{font-size:.75rem;color:var(--text-dim)}

/* SECTION HEADER */
.section-header{display:flex;align-items:center;justify-content:space-between;padding:1rem 1rem .5rem}
.section-header h2{font-family:'Kanit',sans-serif;font-size:1.2rem;font-weight:700}
.see-more-btn{background:var(--dark-card);border:1px solid var(--border);color:var(--text-light);border-radius:8px;padding:.4rem .9rem;font-size:.85rem;cursor:pointer;font-family:'Sarabun',sans-serif;transition:all .2s}
.see-more-btn:hover{border-color:var(--gold);color:var(--gold)}

/* CATEGORY CARDS */
.category-cards{display:flex;flex-direction:column;gap:1rem;padding:.5rem 1rem}
.category-card{background:var(--dark-card);border:1px solid var(--border);border-radius:16px;overflow:hidden;cursor:pointer;transition:all .25s}
.category-card:hover{transform:translateY(-3px);box-shadow:0 8px 25px rgba(180,0,0,.3);border-color:var(--red-accent)}
.category-card-img{width:100%;height:140px;object-fit:cover;display:block;background:var(--dark-card2)}
.category-card-img-placeholder{width:100%;height:140px;background:linear-gradient(135deg,var(--red-dark),#3d0000);display:flex;align-items:center;justify-content:center;font-size:3rem}
.category-card-info{padding:1rem}
.category-card-name{font-weight:700;font-size:1.05rem;margin-bottom:.25rem}
.category-card-count{color:var(--text-dim);font-size:.85rem;margin-bottom:.75rem}

/* CATEGORY GRID */
.category-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;padding:1rem}
.category-grid-item{background:var(--dark-card);border:1px solid var(--border);border-radius:12px;overflow:hidden;cursor:pointer;transition:all .2s}
.category-grid-item:hover{border-color:var(--red-accent)}
.category-grid-item img{width:100%;height:100px;object-fit:cover}
.category-grid-item-name{padding:.6rem;font-weight:600;font-size:.9rem}

/* PRODUCTS GRID */
.products-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;padding:0 1rem 1rem}
@media(min-width:600px){.products-grid{grid-template-columns:repeat(3,1fr)}}
.product-card{background:var(--dark-card);border:1px solid var(--border);border-radius:12px;overflow:hidden;cursor:pointer;transition:all .25s;position:relative}
.product-card:hover{transform:translateY(-3px);box-shadow:0 8px 25px rgba(180,0,0,.3);border-color:var(--red-accent)}
.product-badge{position:absolute;top:.5rem;left:.5rem;background:var(--red-bright);color:#fff;font-size:.65rem;font-weight:700;padding:.2rem .5rem;border-radius:4px}
.product-card img{width:100%;aspect-ratio:1;object-fit:cover;background:var(--dark-card2)}
.product-img-placeholder{width:100%;aspect-ratio:1;background:linear-gradient(135deg,var(--red-dark),#3d0000);display:flex;align-items:center;justify-content:center;font-size:2.5rem}
.product-card-body{padding:.75rem}
.product-card-name{font-weight:700;font-size:.85rem;margin-bottom:.25rem;line-height:1.3}
.product-card-price{color:var(--red-accent);font-weight:800;font-size:1rem}
.product-card-original{color:var(--text-dim);font-size:.75rem;text-decoration:line-through}
.product-card-stock{color:var(--text-dim);font-size:.75rem}

/* PRODUCT DETAIL */
.product-detail-container{padding:1rem}
.product-detail-img{width:100%;border-radius:16px;max-height:250px;object-fit:cover}
.product-detail-img-placeholder{width:100%;height:220px;background:linear-gradient(135deg,var(--red-dark),#3d0000);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:5rem;margin-bottom:1rem}
.product-detail-name{font-family:'Kanit',sans-serif;font-size:1.5rem;font-weight:800;margin:1rem 0 .5rem}
.product-detail-price{font-size:1.8rem;font-weight:900;color:var(--red-accent);margin-bottom:.5rem}
.product-detail-desc{color:var(--text-dim);margin-bottom:1rem;line-height:1.6}
.product-detail-stock{color:var(--text-dim);font-size:.9rem;margin-bottom:1.5rem}

/* PAGE HEADER */
.page-header{padding:1.25rem 1rem .5rem;border-bottom:1px solid var(--border);margin-bottom:1rem}
.page-header h1{font-family:'Kanit',sans-serif;font-size:1.6rem;font-weight:800}
.page-header p{color:var(--text-dim);font-size:.9rem}
.breadcrumb{color:var(--text-dim);font-size:.8rem;margin-bottom:.5rem;cursor:pointer}
.discount-badge{background:linear-gradient(135deg,var(--gold),#c8820a);color:#1a0000;font-weight:800;font-size:.7rem;padding:.15rem .4rem;border-radius:4px}

/* TOPUP */
.topup-methods{display:flex;flex-direction:column;gap:1rem;padding:0 1rem}
.topup-card{background:var(--dark-card);border:1px solid var(--border);border-radius:16px;padding:2rem 1.5rem;text-align:center;cursor:pointer;transition:all .25s;width:100%;-webkit-tap-highlight-color:transparent}
.topup-card:hover,.topup-card:active{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 8px 25px rgba(180,0,0,.3)}
.topup-icon{font-size:3.5rem;margin-bottom:.75rem}
.topup-card h3{font-size:1.1rem;font-weight:700;margin-bottom:.5rem}
.topup-fee{font-size:.85rem;color:var(--text-dim);display:flex;align-items:center;justify-content:center;gap:.4rem}
.fee-badge{background:var(--green-ok);color:#fff;font-size:.7rem;font-weight:700;padding:.15rem .4rem;border-radius:4px}
.topup-form-section{margin:1.5rem 1rem 0;background:var(--dark-card);border:1px solid var(--border);border-radius:16px;padding:1.25rem}
.topup-form-section h3{margin-bottom:1rem;color:var(--gold)}
.topup-status{margin-top:.75rem;padding:.75rem;border-radius:8px;font-size:.9rem;display:none;white-space:pre-line;line-height:1.5}
.topup-status.success{background:rgba(34,197,94,.15);color:var(--green-ok);border:1px solid var(--green-ok);display:block}
.topup-status.error{background:rgba(239,68,68,.15);color:#f87171;border:1px solid #f87171;display:block}
.topup-status.loading{background:rgba(245,166,35,.1);color:var(--gold);border:1px solid var(--gold);display:block}

/* CONTACT */
.contact-cards{padding:0 1rem;display:flex;flex-direction:column;gap:1rem}
.contact-card{display:flex;align-items:center;gap:1.25rem;background:var(--dark-card);border:1px solid var(--border);border-radius:16px;padding:1.25rem;transition:all .2s;cursor:pointer}
.contact-card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(0,0,0,.3)}
.contact-card.facebook{border-color:rgba(24,119,242,.4)}
.contact-card.facebook:hover{border-color:#1877f2;box-shadow:0 8px 25px rgba(24,119,242,.25)}
.contact-card img{width:56px;height:56px;object-fit:contain;border-radius:12px;flex-shrink:0}
.contact-card h3{font-weight:700;margin-bottom:.25rem;font-size:1.05rem}
.contact-card p{color:var(--text-dim);font-size:.85rem}

/* PROFILE & ADMIN TABS */
.profile-tabs,.admin-tabs{display:flex;gap:.5rem;overflow-x:auto;padding:.75rem 1rem;border-bottom:1px solid var(--border);scrollbar-width:none;-webkit-overflow-scrolling:touch}
.profile-tabs::-webkit-scrollbar,.admin-tabs::-webkit-scrollbar{display:none}
.tab-btn{white-space:nowrap;flex-shrink:0;background:var(--dark-card);border:1px solid var(--border);color:var(--text-dim);border-radius:8px;padding:.55rem 1rem;font-size:.85rem;cursor:pointer;transition:all .2s;font-family:'Sarabun',sans-serif;-webkit-tap-highlight-color:transparent}
.tab-btn.active{background:var(--red-main);color:#fff;border-color:var(--red-bright)}
.tab-btn:hover:not(.active){border-color:var(--red-accent);color:var(--text-light)}

/* PROFILE */
.profile-info-card{margin:1rem;background:var(--dark-card);border:1px solid var(--border);border-radius:16px;padding:1.25rem}
.profile-avatar{width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--red-bright),var(--red-dark));display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:900;color:#fff;margin-bottom:1rem}
.profile-username{font-family:'Kanit',sans-serif;font-size:1.4rem;font-weight:800}
.profile-email{color:var(--text-dim);font-size:.9rem}
.profile-balance{color:var(--gold);font-size:1.1rem;font-weight:700;margin-top:.5rem}

/* HISTORY */
.history-item{margin:0 1rem .75rem;background:var(--dark-card);border:1px solid var(--border);border-radius:12px;padding:1rem;display:flex;align-items:center;justify-content:space-between;gap:.75rem}
.history-item-left{display:flex;align-items:center;gap:.75rem;flex:1}
.history-item-icon{font-size:1.5rem;min-width:36px;text-align:center}
.history-item-name{font-weight:600;font-size:.95rem}
.history-item-date{color:var(--text-dim);font-size:.8rem}
.history-item-amount{font-weight:800;white-space:nowrap}
.badge-success{background:rgba(34,197,94,.15);color:var(--green-ok);padding:.2rem .6rem;border-radius:4px;font-size:.75rem;font-weight:700}
.badge-pending{background:rgba(245,166,35,.15);color:var(--gold);padding:.2rem .6rem;border-radius:4px;font-size:.75rem;font-weight:700}

/* COUPON */
.coupon-section{margin:1rem}
.coupon-section h3{margin-bottom:.75rem;color:var(--gold)}
.coupon-input-row{display:flex;gap:.5rem}
.coupon-input-row input{flex:1;padding:.75rem 1rem;background:var(--dark-card);border:1px solid var(--border);border-radius:8px;color:var(--text-light);font-family:'Sarabun',sans-serif;font-size:1rem;outline:none}
.coupon-input-row input:focus{border-color:var(--gold)}
.coupon-card{background:linear-gradient(135deg,var(--dark-card2),var(--dark-card));border:1px dashed var(--gold);border-radius:12px;padding:1rem;display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem}
.coupon-code{font-family:'Kanit',sans-serif;font-weight:700;color:var(--gold);font-size:1.1rem}
.coupon-discount{color:var(--red-accent);font-weight:700}

/* ADMIN */
.admin-dashboard{padding:1rem;display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
.admin-stat-card{background:var(--dark-card);border:1px solid var(--border);border-radius:12px;padding:1rem}
.admin-stat-card .label{color:var(--text-dim);font-size:.8rem;margin-bottom:.25rem}
.admin-stat-card .value{font-family:'Kanit',sans-serif;font-size:1.6rem;font-weight:800;color:var(--red-accent)}
.admin-section{padding:1rem}
.admin-section h3{margin-bottom:1rem;color:var(--gold)}
.admin-form{background:var(--dark-card);border:1px solid var(--border);border-radius:12px;padding:1.25rem;margin-bottom:1rem}
.admin-form h4{margin-bottom:1rem;color:var(--gold)}
.admin-table{width:100%;border-collapse:collapse}
.admin-table th{background:var(--dark-card2);padding:.6rem;text-align:left;font-size:.8rem;color:var(--text-dim);border-bottom:1px solid var(--border)}
.admin-table td{padding:.7rem .6rem;border-bottom:1px solid var(--border);font-size:.85rem}
.admin-table tr:hover td{background:rgba(180,0,0,.1)}
.action-btn{background:none;border:1px solid var(--border);color:var(--text-dim);border-radius:6px;padding:.3rem .7rem;font-size:.75rem;cursor:pointer;transition:all .15s;font-family:'Sarabun',sans-serif}
.action-btn:hover{border-color:var(--red-accent);color:var(--red-accent)}
.action-btn.danger:hover{border-color:#f87171;color:#f87171}
.action-btn.success-btn:hover{border-color:var(--green-ok);color:var(--green-ok)}

/* FORM */
.form-group{margin-bottom:1rem}
.form-group label{display:block;margin-bottom:.4rem;font-size:.9rem;color:var(--text-dim);font-weight:600}
.form-input{width:100%;padding:.75rem 1rem;background:var(--dark-bg);border:1px solid var(--border);border-radius:8px;color:var(--text-light);font-family:'Sarabun',sans-serif;font-size:1rem;outline:none;transition:border-color .2s}
.form-input:focus{border-color:var(--red-bright)}
.form-input::placeholder{color:var(--text-dim)}
small{color:var(--text-dim);font-size:.8rem}
.grid-2{display:gri
